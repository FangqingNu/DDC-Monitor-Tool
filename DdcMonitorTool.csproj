<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DdcMonitorTool</RootNamespace>
    <AssemblyName>DdcMonitorTool</AssemblyName>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>10.0</LangVersion>

    <!-- DPI 感知在 app.manifest 中声明为 PerMonitorV2，避免 125%/150% 下界面模糊 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>

    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <Product>DDC 显示器工具</Product>
    <Description>通过 DDC/CI 控制外接显示器的亮度、对比度、色彩与输入源</Description>
    <Company>DdcMonitorTool</Company>

    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- DPI 感知刻意写在 app.manifest 里（从资源管理器启动也生效），
         因此关掉 WinForms 分析器"请改用 ApplicationHighDpiMode"的提示 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

</Project>
